# Only needed for optional real providers. The demo and tests never read these.
# Real providers also refuse to send unless you pass --allow-network.
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=set-a-model-you-have-verified
